package com.java.programs;

import java.util.HashMap;
import java.util.Iterator;
import java.util.Map.Entry;

public class HashMapDemo {

	public static void main(String[] args) {
		// TODO Auto-generated method stub

		 //   Map (Interface) <---implements--- HashMap(class)
		
		//Keyvalue pairs (concepts)
		
		//values can be duplicated but key should be unique
		
		// Declearation
		
		//Map hm = new HashMap();
		
		
//		Employee id       employee name
//		101               Rajesh
//		102               Kumar
//		103 			  Mini
		
		HashMap<Integer, String> hm = new HashMap<Integer,String>();
		
		System.out.println(hm.size());

		
		hm.put(101, "Rajesh");
		hm.put(102,"Kumar");
		hm.put(103, "MINI");
		hm.put(102, "Krishna");
		hm.put(104,"Kumar");
		hm.put(105, null);
		
		System.out.println(hm);

		System.out.println(hm.size());
		
		
	//remove pair
		
		hm.remove(103);
		
		
		System.out.println(hm);
		
		
		//access values of the key
		
		
		//hm.get(101);
		
		System.out.println("getting specific key value"+hm.get(101)); //getting specific key value Rajesh
		
		
		//to get the all keys from hashmap
		
		System.out.println(hm.keySet()); //[101, 102, 104, 105]
		
		
	System.out.println(hm.values()); //[Rajesh, Krishna, Kumar, null]
	

	// to get all key and values 
	
	System.out.println(hm.entrySet());
	
	
	//reading data from hashmap
	
	
	// using for each 
	
	for(int keeyset: hm.keySet())

	{
		//System.out.println("This is for *** using FOREACH Key and values ***");
		System.out.println(keeyset+" "+hm.get(keeyset));
	}
	
	
	
	//using iterator 
	
	Iterator<Entry<Integer, String>> it=hm.entrySet().iterator();
	
while(it.hasNext())
{
	System.out.println(it.next());
}
	}

	
	
}
